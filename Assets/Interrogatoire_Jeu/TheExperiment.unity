  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 436
  indentLevel: 1
  storyText: "Viktor ne sera pas aussi facile. Il est taill\xE9 dans un autre bois"
  description: 
  character: {fileID: 1731771645}
  portrait: {fileID: -4143916875598900124, guid: 60a44ffdf9b3b0041976eb75683786dd, type: 3}
