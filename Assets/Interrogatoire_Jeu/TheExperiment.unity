  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 426
  indentLevel: 1
  storyText: C'est fini, Sanchez. Je ne ferai pas un pas de plus.
  description: 
  character: {fileID: 1381244308}
  portrait: {fileID: 3401097197927122446, guid: 0a01f0917caec3a419fa3fb274772fc4, type: 3}
