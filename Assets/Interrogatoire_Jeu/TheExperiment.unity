  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 467
  indentLevel: 0
  storyText: "C'est ce que tu esp\xE8res. Mais j'ai toute une arm\xE9e de flics qui
    ratissent la ville en ce moment m\xEAme."
  description: 
  character: {fileID: 1731771645}
  portrait: {fileID: -4143916875598900124, guid: 60a44ffdf9b3b0041976eb75683786dd, type: 3}
