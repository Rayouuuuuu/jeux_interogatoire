--- !u!114 &1390555761
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1390555290}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 428
  indentLevel: 1
  storyText: "Mes \xE9tats d'\xE2me ? Tu as tortur\xE9 ce gamin !"
  description: 
  character: {fileID: 1381244308}
  portrait: {fileID: -5937704545084065829, guid: 0c8dedb5407a6c745a48a35399c629b3, type: 3}
