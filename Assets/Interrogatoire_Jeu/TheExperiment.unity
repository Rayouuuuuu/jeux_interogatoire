  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 429
  indentLevel: 1
  storyText: "Je suis flic, Sanchez, pas une bouch\xE8re. "
  description: 
  character: {fileID: 1381244308}
  portrait: {fileID: 3401097197927122446, guid: 0a01f0917caec3a419fa3fb274772fc4, type: 3}
