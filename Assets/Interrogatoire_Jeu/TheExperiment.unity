  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 432
  indentLevel: 1
  storyText: "L\xE9a ne sera plus la pour vous \xE9paul\xE9 "
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
