--- !u!114 &1390555762
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1390555290}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 427
  indentLevel: 1
  storyText: "L\xE9a, on a l'adresse du hangar. Viktor nous attend. On n'a pas le
    temps pour tes \xE9tats d'\xE2me."
  description: 
  character: {fileID: 1731771645}
  portrait: {fileID: -4143916875598900124, guid: 60a44ffdf9b3b0041976eb75683786dd, type: 3}
